{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cuda",
      "displayName": "CUDA (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/cuda",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "120"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cuda-debug",
      "configurePreset": "cuda",
      "configuration": "Debug"
    },
    {
      "name": "cuda-release",
      "configurePreset": "cuda",
      "configuration": "Release"
    }
  ]
}
